<% content_for :title, "Species & Populations | Biologist" %>

<%= turbo_stream_from PopulateSpeciesJob::GLOBAL_STREAM_NAME %>

<div class="w-full max-w-5xl mx-auto space-y-8 pb-16">
  <header class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between border-b border-slate-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Species & Populations</h1>
      <p class="mt-2 text-sm text-slate-600">
        <%= @total_species_count %> species cataloged across <%= @biomes_count %> biomes.
      </p>
    </div>

    <div class="shrink-0">
      <%= render "pages/populate_controls",
                 running: false,
                 action_path: populate_species_index_path,
                 button_label: "Discover Species",
                 controls_target: "populate_all_species_controls",
                 status_message: notice,
                 status_kind: (notice.present? ? :info : nil) %>
    </div>
  </header>

  <%= render "pages/species_list",
             biome_groups: @biome_groups,
             total_species_count: @total_species_count,
             biomes_count: @biomes_count %>
</div>
