<div id="species_list">
  <% if biome_groups.any? %>
    <div class="mb-4 text-sm font-medium text-slate-500">
      <%= pluralize(total_species_count, "species") %> cataloged across <%= pluralize(biome_groups.size, "biome") %>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
      <table class="min-w-[44rem] w-full table-fixed divide-y divide-slate-200 text-left">
        <thead class="bg-slate-50">
          <tr>
            <th scope="col" class="w-1/6 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
              Species / Population
            </th>
            <th scope="col" class="w-5/12 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
              Description
            </th>
            <th scope="col" class="w-5/12 px-5 py-3.5 text-xs font-semibold uppercase tracking-wider text-slate-600">
              Thematic Tags
            </th>
          </tr>
        </thead>

        <% biome_groups.each do |biome, species_records| %>
          <tbody class="divide-y divide-slate-200">
            <tr class="bg-slate-100/80 border-y border-slate-200">
              <th colspan="3" scope="colgroup" class="px-5 py-3 text-left">
                <div class="flex items-center justify-between gap-3">
                  <span class="text-sm font-semibold text-slate-900"><%= biome.name %></span>
                  <span class="text-xs font-medium text-slate-500"><%= pluralize(species_records.size, "species") %></span>
                </div>
              </th>
            </tr>

            <% species_records.each do |sp| %>
              <tr class="align-top transition hover:bg-slate-50/70">
                <td class="px-5 py-4 text-sm font-semibold text-slate-900">
                  <%= link_to sp.name, species_path(sp), class: "text-indigo-600 hover:text-indigo-500 hover:underline" %>
                </td>
                <td class="px-5 py-4 text-sm leading-relaxed text-slate-600">
                  <%= sp.description %>
                </td>
                <td class="px-5 py-4">
                  <% if sp.themes.any? %>
                    <ul class="flex flex-wrap gap-1.5" aria-label="Themes for <%= sp.name %>">
                      <% sp.themes.each do |theme| %>
                        <li class="inline-flex items-center rounded-full border border-indigo-200 bg-indigo-50 px-2.5 py-0.5 text-xs font-medium text-indigo-700">
                          <%= theme %>
                        </li>
                      <% end %>
                    </ul>
                  <% else %>
                    <span class="text-xs text-slate-400">None</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  <% else %>
    <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-10 text-center">
      <h2 class="text-base font-semibold text-slate-900">No species yet</h2>
      <p class="mt-1 text-sm text-slate-600">
        Click <span class="font-medium text-slate-800">Discover Species</span> above to have the agent discover and catalog species for each biome.
      </p>
    </div>
  <% end %>
</div>
